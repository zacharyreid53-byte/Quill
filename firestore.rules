rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The family directory: any signed-in user can see who's here
    // (needed for the Share buttons); only you can edit your own entry.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Your quotes: only you can read, change, or delete them.
      // Any signed-in family member may ADD one (that's how sharing
      // a quote straight into someone's collection works) — but they
      // can never see or touch what's already there.
      match /quotes/{quoteId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 2000;
      }
    }
  }
}
