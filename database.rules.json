{
  "rules": {
    "directory": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 60"
      }
    },
    "users": {
      "$uid": {
        "quotes": {
          ".read": "auth != null && auth.uid === $uid",
          "$qid": {
            ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.exists() && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length < 2000))"
          }
        },
        "collections": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$cid": {
            ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 60"
          }
        },
        "friends": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$fuid": {
            ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 60"
          }
        },
        "shares": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "pit": {
      "admin": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      },
      "market": {
        ".read": "auth != null",
        "question": { ".write": "auth != null && auth.uid === root.child('pit/admin').val()" },
        "description": { ".write": "auth != null && auth.uid === root.child('pit/admin').val()" },
        "resolved": { ".write": "auth != null && auth.uid === root.child('pit/admin').val()" },
        "outcome": {
          ".write": "auth != null && auth.uid === root.child('pit/admin').val()",
          ".validate": "newData.val() === 'yes' || newData.val() === 'no'"
        },
        "b": {
          ".write": "auth != null && auth.uid === root.child('pit/admin').val()",
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "qYes": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" },
        "qNo": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" },
        "participants": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || auth.uid === root.child('pit/admin').val())",
            ".validate": "newData.child('cash').isNumber() && newData.child('cash').val() >= 0 && newData.child('yes').isNumber() && newData.child('yes').val() >= 0 && newData.child('no').isNumber() && newData.child('no').val() >= 0"
          }
        }
      }
    }
  }
}
